# Copy to .env.local (never commit it). Paths below are examples — adjust to your PC.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=240000

# Full paths if the tools are not on PATH, e.g. C:\tools\piper\piper.exe
PIPER_EXE=piper
PIPER_VOICE=C:\tools\piper\voices\pt_BR-faber-medium.onnx
FFMPEG_EXE=ffmpeg
FFPROBE_EXE=ffprobe

OUTPUT_DIR=./output
DB_PATH=./output/factory.db

# Local API: keep bound to localhost
API_HOST=127.0.0.1
API_PORT=8787
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

MAX_ATTEMPTS=3
WORKER_POLL_MS=2000
MIN_DURATION_SEC=15
MAX_DURATION_SEC=90

# Publishing stays off until the official TikTok Content Posting API is connected and approved
PUBLISHING_ENABLED=false

# ---- Pesquisa e imagens ----
RESEARCH_ENABLED=true
WIKIPEDIA_LANG=pt
MAX_SOURCES=4
COMMONS_ENABLED=true
# Suas imagens (jpg/png). Opcional: .json ao lado com {"license":"...","author":"...","source_url":"...","tags":["urna"]}
ASSETS_DIR=./assets/library
CAPTION_FONT=Arial
# Wikimedia pede um User-Agent com contato
HTTP_USER_AGENT=PixelPerfectLocalFactory/1.0 (seu-email@exemplo.com)
SCHEDULER_TICK_MS=30000

# ---- TikTok (API oficial: Login Kit + Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8787/tiktok/callback
TIKTOK_APP_TYPE=desktop
